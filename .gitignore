# Data files
data/pride_and_prejudice.txt
data/lastfm/
data/ml-1m/
data/*.zip
data/*.tar.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# LaTeX — ignore build artefacts, keep source and PDF
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.synctex.gz
report/*.fdb_latexmk
report/*.fls
report/_minted*
# ignore the figures subfolder inside report/ (PNGs live in results/figures/)
report/figures/

# Explicitly un-ignore the files we want tracked in report/
!report/main.tex
!report/refs.bib
!report/*.pdf

# Results - keep figures and tables
results/*.tmp
